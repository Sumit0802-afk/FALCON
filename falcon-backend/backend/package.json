{
  "name": "falcon-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "ts-node database/seed.ts",
    "templates:seed": "ts-node scripts/generate-templates.ts --count 168 --publish",
    "templates:generate": "ts-node scripts/generate-templates.ts",
    "templates:import": "ts-node scripts/import-templates.ts",
    "email:sync": "ts-node scripts/sync-email-core.ts",
    "library:seed": "ts-node --transpile-only scripts/seed-library.ts",
    "library:audit": "ts-node --transpile-only scripts/audit-library.ts",
    "test:library": "ts-node --transpile-only tests/library.test.ts",
    "email:seed": "ts-node --transpile-only scripts/seed-email-templates.ts",
    "test:auth": "ts-node tests/auth.test.ts",
    "test:account": "ts-node tests/account.test.ts",
    "test:email": "ts-node --transpile-only tests/emailTemplates.test.ts",
    "test:templates": "ts-node tests/templates.test.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "^4.21.1",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "20.14.9",
    "@types/nodemailer": "^8.0.2",
    "prisma": "5.22.0",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.5.3"
  }
}
