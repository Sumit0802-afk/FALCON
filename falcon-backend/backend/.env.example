# Database connection string used by Prisma
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/falcon"

# Server configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Public origin of this API. Image URLs inside email templates are built from it,
# so set it to your deployed API URL in production (defaults to the request host).
PUBLIC_API_URL=http://localhost:4000

# Authentication & Session Security
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# Also keys the stored OTP hashes. Required in production.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── EMAIL (SMTP) ──────────────────────────────────────────────────────────────
# Sign-in codes and password reset links are sent from the backend over SMTP.
# For Gmail: SMTP_USER is the mailbox, SMTP_PASSWORD is a Google "app password".
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Falcon" <no-reply@example.com>
# AI Studio uses OpenAI with OPENAI_API_KEY by default. To use another service that speaks the same
# protocol, give its address, key and one of its models here. Examples of AI_BASE_URL:
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
# Models used by AI Studio. Leave empty for OpenAI's defaults; required for another service.
# Several may be listed, separated by commas: the next is tried when one is busy or no longer offered.
# e.g. AI_TEXT_MODEL=gemini-flash-latest,gemini-flash-lite-latest
AI_TEXT_MODEL=
# Leave empty with another service unless it can make pictures; AI Studio then uses stock photographs.
AI_IMAGE_MODEL=
# Public address of this server, used in links to pictures AI Studio makes. Defaults to the address of the request.
PUBLIC_API_URL=
# Public https address of this server's /email-assets folder, e.g. https://api.example.com/email-assets
# Set it once the server is reachable from the internet: pictures of a design's glow, outline and 3D
# effects are then saved here and linked from the email. Left empty, no such pictures are sent and the
# effects go in their plain form. Pictures are never attached to an email.
EMAIL_ASSET_BASE_URL=
# Path to Chrome, Edge or Chromium, if it is not in a standard place. Needed to draw design effects.
CHROME_PATH=
# Where "Help & Support" messages are delivered. Defaults to the SMTP_FROM mailbox.
SUPPORT_EMAIL=support@example.com
