# Database connection string used by Prisma
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/falcon"

# Server configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Public origin of this API. Image URLs inside email templates are built from it,
# so set it to your deployed API URL in production (defaults to the request host).
PUBLIC_API_URL=http://localhost:4000

# Authentication & Session Security
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# Also keys the stored OTP hashes. Required in production.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── EMAIL (SMTP) ──────────────────────────────────────────────────────────────
# Sign-in codes and password reset links are sent from the backend over SMTP.
# For Gmail: SMTP_USER is the mailbox, SMTP_PASSWORD is a Google "app password".
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Falcon" <no-reply@example.com>
# Where "Help & Support" messages are delivered. Defaults to the SMTP_FROM mailbox.
SUPPORT_EMAIL=support@example.com
