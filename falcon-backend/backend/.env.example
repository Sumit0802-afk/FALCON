# Database connection string used by Prisma
DATABASE_URL="mysql://falcon:falcon@localhost:3306/falcon"

# Server configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Authentication & Session Security
JWT_SECRET=falcon_super_secret_jwt_key_change_in_production_2024
JWT_EXPIRES_IN=7d

# ── EMAIL DISPATCH CONFIGURATION (Resend API - Primary) ────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_123456789abcdef...
RESEND_FROM="Falcon Intelligence" <onboarding@resend.dev>

# ── Optional Fallback (SMTP) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="Falcon Intelligence" <notifications@falcon.design>
